#!/usr/bin/env bash

set -euo pipefail

plugin_id="io.github.loedn.workspace-router"
config_dir="${OMARCHY_WORKSPACE_APPS_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/hypr}"
state_file="$config_dir/workspace-apps.json"
rules_file="$config_dir/workspace-apps.lua"
hyprland_file="$config_dir/hyprland.lua"
integration_marker="-- Workspace Router plugin integration"
integration_require='require("hypr.workspace-apps")'
menu_file="${OMARCHY_WORKSPACE_ROUTER_MENU_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/extensions/omarchy-menu.jsonc}"
menu_marker_begin="// Workspace Router plugin menu entry - begin"
menu_marker_end="// Workspace Router plugin menu entry - end"

notify() {
  [[ ${OMARCHY_WORKSPACE_ROUTER_NO_NOTIFY:-0} == 1 ]] && return 0
  omarchy notification send "$1" "${2:-}" -g "󰍹"
}

clean_menu_entries() {
  local source="$1" destination="$2"
  awk \
    -v marker_begin="$menu_marker_begin" \
    -v marker_end="$menu_marker_end" '
      index($0, marker_begin) { managed = 1; next }
      managed {
        if (index($0, marker_end)) managed = 0
        next
      }
      !legacy && $0 ~ /^[[:space:]]*"setup\.workspace-apps([.][^"]*)?"[[:space:]]*:/ {
        if ($0 !~ /},?[[:space:]]*$/) legacy = 1
        next
      }
      legacy {
        if ($0 ~ /^[[:space:]]*},?[[:space:]]*$/) legacy = 0
        next
      }
      { print }
    ' "$source" >"$destination"
}

install_menu_entry() {
  local menu_dir cleaned temporary
  menu_dir=$(dirname "$menu_file")
  mkdir -p "$menu_dir"
  [[ -f $menu_file ]] || printf '{}\n' >"$menu_file"

  cleaned=$(mktemp "$menu_dir/.workspace-router-menu.clean.XXXXXX")
  temporary=$(mktemp "$menu_dir/.workspace-router-menu.XXXXXX")
  clean_menu_entries "$menu_file" "$cleaned"

  if ! awk \
    -v marker_begin="$menu_marker_begin" \
    -v marker_end="$menu_marker_end" '
      {
        lines[NR] = $0
        if ($0 ~ /^[[:space:]]*}[[:space:]]*$/) closing = NR
      }
      END {
        if (!closing) exit 2
        for (i = 1; i <= NR; i++) {
          if (i == closing) {
            print "  " marker_begin
            print "  \"setup.workspace-router\": {"
            print "    \"icon\": \"󰝹\","
            print "    \"label\": \"Workspace Router\","
            print "    \"description\": \"Assign apps to workspaces and choose focus behavior\","
            print "    \"action\": \"omarchy-shell shell summon io.github.loedn.workspace-router\""
            print "  },"
            print "  " marker_end
          }
          print lines[i]
        }
      }
    ' "$cleaned" >"$temporary"; then
    rm -f "$cleaned" "$temporary"
    notify "Workspace Router" "Could not update invalid menu file: $menu_file"
    return 1
  fi

  chmod --reference="$menu_file" "$temporary"
  mv "$temporary" "$menu_file"
  rm -f "$cleaned"
  omarchy-shell -q shell call omarchy.menu refresh "" || true
  notify "Workspace Router" "Added to Setup in the Omarchy menu."
}

remove_menu_entry() {
  local menu_dir temporary
  [[ -f $menu_file ]] || return 0
  menu_dir=$(dirname "$menu_file")
  temporary=$(mktemp "$menu_dir/.workspace-router-menu.XXXXXX")
  clean_menu_entries "$menu_file" "$temporary"
  chmod --reference="$menu_file" "$temporary"
  mv "$temporary" "$menu_file"
  omarchy-shell -q shell call omarchy.menu refresh "" || true
  notify "Workspace Router" "Removed from the Omarchy menu."
}

ensure_state() {
  mkdir -p "$config_dir"
  if [[ ! -f $state_file ]]; then
    printf '%s\n' '{"version":1,"rules":[]}' >"$state_file"
  elif ! jq -e '.version == 1 and (.rules | type == "array")' "$state_file" >/dev/null 2>&1; then
    notify "Workspace Router" "The assignments file is invalid: $state_file"
    return 1
  fi
}

integration_installed() {
  [[ -f $hyprland_file ]] && grep -Fqx -- "$integration_require" "$hyprland_file"
}

lua_long_string() {
  local value="$1"
  local equals=""
  while [[ $value == *"]${equals}]"* ]]; do equals+="="; done
  printf '[%s[%s]%s]' "$equals" "$value" "$equals"
}

regex_escape() {
  local value="$1" character
  for character in "\\" '[' ']' '(' ')' '{' '}' '.' '^' '$' '*' '+' '?' '|'; do
    value=${value//"$character"/\\$character}
  done
  printf '%s\n' "$value"
}

render_rules() {
  ensure_state
  local temporary
  temporary=$(mktemp "$config_dir/.workspace-apps.lua.XXXXXX")

  {
    printf '%s\n' '-- Generated by Workspace Router. Manage this file through the plugin.'
    printf '%s\n\n' '-- Each assignment controls its workspace and whether focus follows it.'
    while IFS=$'\t' read -r app_class workspace focus; do
      [[ -n $app_class && $workspace =~ ^([1-9]|10)$ ]] || continue
      local escaped pattern workspace_target
      escaped=$(regex_escape "$app_class")
      pattern=$(lua_long_string "^${escaped}$")
      workspace_target="$workspace"
      [[ $focus == "true" ]] || workspace_target+=" silent"
      printf 'o.window({ initial_class = %s }, { workspace = "%s" })\n' "$pattern" "$workspace_target"
    done < <(
      jq -r '.rules | sort_by(.workspace, .class)[] | [.class, (.workspace | tostring), ((.focus // false) | tostring)] | @tsv' "$state_file"
    )
  } >"$temporary"

  luac -p "$temporary"
  mv "$temporary" "$rules_file"
}

reload_hyprland() {
  local errors
  if ! hyprctl reload >/dev/null 2>&1; then
    notify "Workspace Router" "Rules were saved, but Hyprland could not be reloaded."
    return 0
  fi
  errors=$(hyprctl configerrors 2>/dev/null || true)
  [[ -z $errors ]] || notify "Hyprland config error" "$errors"
}

setup_integration() {
  local selection backup temporary

  if integration_installed; then
    render_rules
    reload_hyprland
    notify "Workspace Router" "Hyprland integration is already connected."
    return 0
  fi

  [[ -f $hyprland_file ]] || {
    notify "Workspace Router" "Hyprland config not found: $hyprland_file"
    return 1
  }

  selection=$(omarchy menu select \
    "Connect Workspace Router to Hyprland?" \
    "󰌷"$'\t'"Connect" \
    "󰅖"$'\t'"Cancel" \
    -- --width 500) || return 1
  [[ $selection == "Connect" ]] || return 1

  backup="$hyprland_file.workspace-apps.bak.$(date +%Y%m%d-%H%M%S)"
  cp -a "$hyprland_file" "$backup"
  temporary=$(mktemp "$config_dir/.hyprland.lua.XXXXXX")

  awk \
    -v marker="$integration_marker" \
    -v requirement="$integration_require" \
    -v anchor='require("hypr.autostart")' '
      {
        print
        if (!inserted && $0 == anchor) {
          print marker
          print requirement
          inserted = 1
        }
      }
      END {
        if (!inserted) {
          print ""
          print marker
          print requirement
        }
      }
    ' "$hyprland_file" >"$temporary"

  chmod --reference="$hyprland_file" "$temporary"
  mv "$temporary" "$hyprland_file"
  render_rules
  reload_hyprland
  notify "Workspace Router connected" "Hyprland backup: $backup"
}

ensure_integration() {
  integration_installed || setup_integration
}

disconnect_integration() {
  local selection backup temporary
  if ! grep -Fqx -- "$integration_marker" "$hyprland_file" 2>/dev/null; then
    notify "Workspace Router" "No plugin-managed integration line was found."
    return 0
  fi

  selection=$(omarchy menu select \
    "Stop loading Workspace Router rules?" \
    "󰌾"$'\t'"Disconnect" \
    "󰅖"$'\t'"Keep connected" \
    -- --width 500) || return 0
  [[ $selection == "Disconnect" ]] || return 0

  backup="$hyprland_file.workspace-apps.bak.$(date +%Y%m%d-%H%M%S)"
  cp -a "$hyprland_file" "$backup"
  temporary=$(mktemp "$config_dir/.hyprland.lua.XXXXXX")
  awk \
    -v marker="$integration_marker" \
    -v requirement="$integration_require" '
      $0 == marker { skip_requirement = 1; next }
      skip_requirement && $0 == requirement { skip_requirement = 0; next }
      { skip_requirement = 0; print }
    ' "$hyprland_file" >"$temporary"
  chmod --reference="$hyprland_file" "$temporary"
  mv "$temporary" "$hyprland_file"
  reload_hyprland
  notify "Workspace Router disconnected" "Assignments were kept in $state_file"
}

save_assignment() {
  local app_class="$1" workspace="$2" focus="$3"
  local temporary focus_description
  ensure_state
  temporary=$(mktemp "$config_dir/.workspace-apps.json.XXXXXX")
  jq \
    --arg app_class "$app_class" \
    --argjson workspace "$workspace" \
    --argjson focus "$focus" \
    '.rules = ([.rules[] | select(.class != $app_class)] + [{class: $app_class, workspace: $workspace, focus: $focus}])
      | .rules |= sort_by(.workspace, .class)' \
    "$state_file" >"$temporary"
  mv "$temporary" "$state_file"
  render_rules
  reload_hyprland
  if [[ $focus == "true" ]]; then focus_description="and switch focus there"; else focus_description="without changing focus"; fi
  notify "Workspace rule saved" "$app_class will open on workspace $workspace $focus_description"
}

remove_assignment() {
  local app_class="$1" temporary
  ensure_state
  temporary=$(mktemp "$config_dir/.workspace-apps.json.XXXXXX")
  jq --arg app_class "$app_class" '.rules |= map(select(.class != $app_class))' "$state_file" >"$temporary"
  mv "$temporary" "$state_file"
  render_rules
  reload_hyprland
  notify "Workspace rule removed" "$app_class is no longer assigned"
}

choose_workspace() {
  local options=() workspace
  for workspace in {1..10}; do options+=("󰍹"$'\t'"$workspace"); done
  omarchy menu select "Open on workspace" "${options[@]}" -- --width 360 --maxheight 520
}

choose_focus_behavior() {
  local selection
  selection=$(omarchy menu select \
    "When the app opens" \
    "󰘳"$'\t'"Open silently" \
    "󰍹"$'\t'"Switch to its workspace" \
    -- --width 460) || return 1
  case "$selection" in
    "Open silently") printf '%s\n' "false" ;;
    "Switch to its workspace") printf '%s\n' "true" ;;
    *) return 1 ;;
  esac
}

running_app_options() {
  local clients
  if ! clients=$(hyprctl -j clients 2>/dev/null); then
    notify "Workspace Router" "Could not read Hyprland windows."
    return 1
  fi
  jq -r '
    map({
      class: (if (.initialClass // "") != "" then .initialClass else (.class // "") end),
      title: (.title // ""),
      workspace: (.workspace.id // 0)
    })
    | map(select(.class != ""))
    | unique_by(.class)
    | sort_by(.class | ascii_downcase)
    | .[]
    | .label = (if .title == "" then .class else .title end)
    | ["", (.label + "  ·  workspace " + (.workspace | tostring)), .class]
    | @tsv
  ' <<<"$clients"
}

assign_running_app() {
  local options=() selected app_class workspace focus
  ensure_integration || return 0
  mapfile -t options < <(running_app_options)
  if (( ${#options[@]} == 0 )); then
    notify "Workspace Router" "No running application windows were found."
    return 0
  fi
  selected=$(omarchy menu select "Choose a running app" "${options[@]}" -- --width 620 --maxheight 620) || return 0
  app_class=${selected#*$'\t'}
  workspace=$(choose_workspace) || return 0
  focus=$(choose_focus_behavior) || return 0
  save_assignment "$app_class" "$workspace" "$focus"
}

add_class_manually() {
  local app_class workspace focus
  ensure_integration || return 0
  app_class=$(omarchy menu input "Exact app class") || return 0
  [[ -n $app_class ]] || return 0
  workspace=$(choose_workspace) || return 0
  focus=$(choose_focus_behavior) || return 0
  save_assignment "$app_class" "$workspace" "$focus"
}

manage_assignment() {
  local options=() selected app_class action workspace focus confirmation
  ensure_integration || return 0
  ensure_state
  mapfile -t options < <(
    jq -r '
      .rules | sort_by(.workspace, .class)[]
      | ((.focus // false) as $focus
        | ["󰍹", (.class + "  →  workspace " + (.workspace | tostring) + (if $focus then "  ·  switch focus" else "  ·  silent" end)), .class])
      | @tsv
    ' "$state_file"
  )
  if (( ${#options[@]} == 0 )); then
    notify "Workspace Router" "There are no saved assignments yet."
    return 0
  fi
  selected=$(omarchy menu select "Manage assignment" "${options[@]}" -- --width 560 --maxheight 620) || return 0
  app_class=${selected#*$'\t'}
  workspace=$(jq -r --arg app_class "$app_class" '.rules[] | select(.class == $app_class) | .workspace' "$state_file")
  focus=$(jq -r --arg app_class "$app_class" '.rules[] | select(.class == $app_class) | (.focus // false)' "$state_file")
  action=$(omarchy menu select \
    "$app_class" \
    "󰁝"$'\t'"Move to another workspace" \
    "󰍹"$'\t'"Change launch behavior" \
    "󰆴"$'\t'"Remove assignment" \
    -- --width 460) || return 0
  case "$action" in
    "Move to another workspace") workspace=$(choose_workspace) || return 0; save_assignment "$app_class" "$workspace" "$focus" ;;
    "Change launch behavior") focus=$(choose_focus_behavior) || return 0; save_assignment "$app_class" "$workspace" "$focus" ;;
    "Remove assignment")
      confirmation=$(omarchy menu select "Remove $app_class?" "Keep assignment" "Remove assignment" -- --width 440) || return 0
      [[ $confirmation == "Remove assignment" ]] && remove_assignment "$app_class"
      ;;
  esac
}

status_json() {
  local integrated="false" assignments=0
  integration_installed && integrated="true"
  if [[ -f $state_file ]]; then assignments=$(jq -r '.rules | length' "$state_file" 2>/dev/null || printf '0'); fi
  jq -cn --arg plugin "$plugin_id" --argjson integrated "$integrated" --argjson assignments "$assignments" \
    '{plugin: $plugin, integrated: $integrated, assignments: $assignments}'
}

list_assignments() {
  ensure_state
  jq -r '.rules | sort_by(.workspace, .class)[] | "\(.class)\t\(.workspace)\t\(if (.focus // false) then "switch-focus" else "silent" end)"' "$state_file"
}

main() {
  case "${1:-assign}" in
    assign) assign_running_app ;;
    add) add_class_manually ;;
    manage) manage_assignment ;;
    setup) setup_integration ;;
    disconnect) disconnect_integration ;;
    status) status_json ;;
    list) list_assignments ;;
    render) render_rules ;;
    menu-install) install_menu_entry ;;
    menu-remove) remove_menu_entry ;;
    *)
      printf 'Usage: %s [assign|add|manage|setup|disconnect|status|list|render|menu-install|menu-remove]\n' "${0##*/}" >&2
      return 2
      ;;
  esac
}

main "$@"
